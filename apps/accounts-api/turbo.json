{
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "prisma:generate"],
      "outputs": ["dist/**"]
    },
    "db:down": {
      "cache": false,
      "persistent": false,
      "dependsOn": ["^db:down"]
    },
    "db:down:volumes": {
      "cache": false,
      "persistent": false,
      "dependsOn": ["^db:down:volumes"]
    },
    "db:logs": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^db:logs"]
    },
    "db:migrate": {
      "cache": false,
      "persistent": false,
      "dependsOn": ["db:up", "db:wait", "^db:migrate"],
      "outputs": ["prisma/migrations/**"]
    },
    "db:ps": {
      "cache": false,
      "persistent": false,
      "dependsOn": ["^db:ps"]
    },
    "db:up": {
      "cache": false,
      "persistent": false,
      "dependsOn": ["^db:up"]
    },
    "db:wait": {
      "cache": false,
      "persistent": false,
      "dependsOn": ["db:up", "^db:wait"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["db:up", "db:wait", "prisma:generate", "^dev"]
    },
    "prisma:generate": {
      "cache": false,
      "persistent": false,
      "dependsOn": ["^prisma:generate"],
      "outputs": ["src/lib/prisma/**"]
    },
    "prisma:studio": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["db:up", "db:wait", "^prisma:studio"]
    },
    "start": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["build", "db:up", "db:wait", "^start"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck", "prisma:generate"],
      "outputs": []
    }
  }
}
