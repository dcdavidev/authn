generator client {
  provider = "prisma-client"
  output   = "../src/lib/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  /// Pseudonymous identifier (UUIDv7) to prevent enumeration and avoid exposing PII in URLs/logs.
  id String @id @default(uuid(7)) @db.Uuid

  // Core Identity & Authentication
  email           String    @unique @db.VarChar(320)
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)
  passwordHash    String?   @map("password_hash") @db.Text
  mfaEnabled      Boolean   @default(false) @map("mfa_enabled")

  // Optional Profile PII (Minimized & Erasable on Anonymization)
  displayName String?  @map("display_name") @db.VarChar(150)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("users")
}
