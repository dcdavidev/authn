{
  "name": "@authn/accounts-api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:down": "podman compose down",
    "db:down:volumes": "podman compose down -v",
    "db:logs": "podman compose logs -f postgres",
    "db:migrate": "pnpm exec prisma migrate dev --name $(pnpm exec tsx scripts/generate-migration-name.ts)",
    "db:ps": "podman compose ps",
    "db:up": "podman compose up -d",
    "db:wait": "until podman exec -i authn-accounts-postgres pg_isready -U postgres; do sleep 1; done",
    "dev": "tsx watch src/index.ts",
    "prisma:generate": "pnpm exec prisma generate",
    "prisma:studio": "pnpm exec prisma studio",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "^2.38.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "7",
    "dotenv": "^18.0.9",
    "email-regex": "^6.1.0",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "wnodex": "^0.5.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "prisma": "^7.10.1",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "unique-names-generator": "^4.7.1"
  }
}
