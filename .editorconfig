# EditorConfig is awesome: https://editorconfig.org

# Top-level EditorConfig
root=true

# Global defaults for all files
[*]
charset=utf-8
end_of_line=lf
insert_final_newline=true
trim_trailing_whitespace=true
indent_style=space
indent_size=2

# JavaScript, TypeScript, and modern modules
[*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}]
indent_style=space
indent_size=2
max_line_length=80

# Web frameworks
[*.{astro,svelte,vue}]
indent_style=space
indent_size=2

# JSON, JSON5, JSONC, and configuration files
[*.{json,json5,jsonc}]
indent_style=space
indent_size=2

# Runtime configurations
[.*rc]
indent_style=space
indent_size=2

# YAML and workflow configurations
[*.{yml,yaml}]
indent_style=space
indent_size=2

# Markdown documentation
[*.md]
trim_trailing_whitespace=false

# TOML configuration files
[*.toml]
indent_style=space
indent_size=2
max_line_length=100

# XML and SVG graphics
[*.{xml,svg}]
indent_style=space
indent_size=2

# Shell scripts
[*.{sh,bash,zsh}]
indent_style=space
indent_size=2

# Makefiles require hard tabs
[Makefile]
indent_style=tab
indent_size=4
