{
  "name": "authn",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "build:force": "turbo run build --force",
    "check": "pnpm run lint && pnpm run fmt && pnpm run spellcheck && pnpm run test",
    "check:ci": "pnpm run lint:check && pnpm run fmt:check && pnpm run spellcheck && pnpm run test:force",
    "clean": "rm -rf .turbo packages/*/.turbo packages/*/dist",
    "commit": "pnpm exec cz",
    "commit:lint": "pnpm exec commitlint --from=HEAD~1",
    "db:down": "pnpm --filter @authn/accounts-api run db:down",
    "db:down:volumes": "pnpm --filter @authn/accounts-api run db:down:volumes",
    "db:logs": "pnpm --filter @authn/accounts-api run db:logs",
    "db:ps": "pnpm --filter @authn/accounts-api run db:ps",
    "db:up": "pnpm --filter @authn/accounts-api run db:up",
    "dev": "turbo dev",
    "fmt": "pnpm exec prettier --ignore-unknown --write .",
    "fmt:check": "pnpm exec prettier --ignore-unknown --check .",
    "format": "pnpm exec prettier --write .",
    "lint": "pnpm exec eslint --no-warn-ignored --fix .",
    "lint:check": "pnpm exec eslint --no-warn-ignored .",
    "lint:fix": "pnpm exec eslint --fix .",
    "lint:fmt": "pnpm run lint && pnpm run fmt",
    "prepare": "lefthook install",
    "publish": "pnpm run version && pnpm run release",
    "release": "pnpm exec dropdx",
    "spellcheck": "pnpm exec cspell --no-progress --no-summary .",
    "spellcheck:all": "pnpm exec cspell .",
    "test": "turbo run test",
    "test:force": "turbo run test --force",
    "test:unit": "turbo run test",
    "test:watch": "turbo run test -- --watch",
    "turbo:update": "pnpm dlx @turbo/codemod@latest update --force"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@cspell/cspell-types": "^10.4.0",
    "@dcdavidev/dropdx": "^0.4.0",
    "@prettier/plugin-xml": "^3.4.2",
    "commitizen": "^4.3.2",
    "commitlint-config-spellbookx": "^0.11.1",
    "cspell": "^10.4.0",
    "cspell-config-spellbookx": "^1.3.0",
    "cz-config-spellbookx": "^1.3.0",
    "cz-git": "^1.14.0",
    "czg": "^1.14.0",
    "eslint": "^9.39.2",
    "eslint-plugin-spellbookx": "^0.11.1",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.9",
    "prettier-config-spellbookx": "^0.11.1",
    "turbo": "^2.11.10"
  },
  "packageManager": "pnpm@9.0.0"
}
