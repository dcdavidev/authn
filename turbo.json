{
  "$schema": "https://v2-11-10.turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "build/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^dev"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": [".react-router/**"]
    }
  }
}
